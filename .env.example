# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Configuración > API en el dashboard de supabase.com). La anon key es pública
# y está protegida por Row Level Security; nunca uses aquí la "service_role" key.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
